      "parameters": {
        "jsCode": "\nlet newRoots = [\n\t\"https://l1uatclient.sgamesuat.com/\",\n\t\"https://l1uatproxy.sgamesuat.com/\"\n]\nconst defaultRoot = \"https://l1uatcli.foodpandaoh.net/\";\n\nfor (const item of $input.all()) {\n  item.json.newDomains = [];\n  if(item.json.SiteUrls !== null && item.json.SiteUrls.length > 0)\n  {\n      if(item.json.SiteUrls[0].includes(defaultRoot) )\n    {\n        item.json.newDomains = newRoots.map(\n          root => item\n                  .json.SiteUrls[0]\n                  .replace(defaultRoot, root)\n                  .trim());\n    }  \n  }  \n}\n\nreturn $input.all();"
      },
