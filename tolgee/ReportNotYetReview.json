    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "if (!$json.translations[$json.languageBase]?.text) {\n  return {\n    project: $json.project,\n    ns: $json.keyNamespace,\n    value: $json.keyName,\n    missing: []\n  }\n}\nconst item = {\n  value: $json.translations[$json.languageBase]?.text ?? $json.keyName,\n  keyName: $json.keyName,\n  keyNamespace: $json.keyNamespace,\n  project: $json.project,\n  missing: []\n}\nfor (const lang of $json.lang) {\n  if ($json.translations[lang.tag] &&  $json.translations[lang.tag].state === \"TRANSLATED\") {\n    item.missing.push(lang)\n  } \n}\n\nreturn item;"
